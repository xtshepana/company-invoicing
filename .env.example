# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this app is deployed at (used for auth email redirect links,
# the cron self-trigger, and client-portal magic links). Server-only - built
# into links at request time, never read from the browser, so this
# deliberately isn't NEXT_PUBLIC_-prefixed (that would get it inlined into
# the build output at build time instead of read fresh at runtime). Also
# deliberately not named APP_URL - on Hostinger's Node.js hosting that name
# was silently overridden by the platform's own internal bind address
# (0.0.0.0:<port>) regardless of what was set in its env var panel.
SITE_URL=http://localhost:3000

# Shared secret required in the `Authorization: Bearer <value>` header of
# every request to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (transactional email — invoices, reminders, etc.)
RESEND_API_KEY=
EMAIL_FROM="Company Invoicing <invoices@yourdomain.com>"

# Playwright e2e tests only. Create the account with
# `node scripts/create-e2e-user.mjs` (reads these two vars), then run
# `npm run test:e2e`. Never point this at a real staff member's account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
